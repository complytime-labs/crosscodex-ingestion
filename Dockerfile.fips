# CrossCodex Ingestion Service - FIPS 140-2 Compliant Container Image
# Multi-stage build using Red Hat Universal Base Image (UBI9) with FIPS mode enabled

# Stage 1: Builder - Install dependencies, generate proto stubs, install the package, fetch models
FROM registry.access.redhat.com/ubi9/python-312:1-1793738546 AS builder

# Pinned by tag and digest for reproducible builds; 0.13.7 is the uv version the lock was written with.
COPY --from=ghcr.io/astral-sh/uv:0.13.7@sha256:96f40d3904aad8d0bd010539001d36c8e2188b981e1334471a90c4a1d93bb490 /uv /usr/local/bin/uv

WORKDIR /app

# UBI Python images run as arbitrary UID, ensure write access. Also install the shared libraries
# OpenCV (imported by Docling's RapidOCR) needs, because docling-tools imports Docling to
# download the models.
USER 0
RUN dnf install -y mesa-libGL glib2 libxcb && dnf clean all && \
    chown -R 1001:0 /app && chmod -R g=u /app
USER 1001

# The UBI Python image ships its Python 3.12 as a venv at /opt/app-root. `uv pip install --system`
# ignores it and targets the system Python 3.9, so point uv at the venv instead.
ENV VIRTUAL_ENV=/opt/app-root

# Install third-party dependencies first (layer caching); the package itself needs src/ and README.md.
# Install exactly what uv.lock pins, hash-checked: resolving pyproject.toml afresh drifts from the
# lock, and the model revisions in scripts/download_models.py match the locked Docling.
# torch comes from the CPU-only index recorded in the lock (--emit-index-url); that index also
# hosts non-torch names, so best-match across indexes is needed. --require-hashes keeps it safe.
COPY --chown=1001:0 pyproject.toml uv.lock ./
RUN uv export --locked --no-dev --no-emit-project --emit-index-url --format requirements.txt -o /tmp/requirements.txt && \
    uv pip install --no-cache --require-hashes --index-strategy unsafe-best-match -r /tmp/requirements.txt

# Copy proto files and generate gRPC stubs. The code generators (grpcio-tools, mypy-protobuf) come
# from the lock's dev group, hash-checked, into a separate venv: installing them next to the
# runtime packages would change the runtime grpcio/protobuf and ship build tools in the image.
COPY --chown=1001:0 proto/ proto/
RUN uv export --locked --only-group dev --no-emit-project --format requirements.txt -o /tmp/codegen-requirements.txt && \
    uv venv /tmp/codegen && \
    uv pip install --python /tmp/codegen/bin/python --no-cache --require-hashes -r /tmp/codegen-requirements.txt && \
    mkdir -p src/crosscodex_ingestion/proto/crosscodex/v1 && \
    PATH="/tmp/codegen/bin:$PATH" /tmp/codegen/bin/python -m grpc_tools.protoc \
      --proto_path=proto \
      --python_out=src/crosscodex_ingestion/proto \
      --grpc_python_out=src/crosscodex_ingestion/proto \
      --mypy_out=src/crosscodex_ingestion/proto \
      crosscodex/v1/common.proto crosscodex/v1/ingestion.proto && \
    touch src/crosscodex_ingestion/proto/__init__.py \
          src/crosscodex_ingestion/proto/crosscodex/__init__.py \
          src/crosscodex_ingestion/proto/crosscodex/v1/__init__.py

# Fix proto imports to match package path
RUN find src/crosscodex_ingestion/proto -name '*_pb2*.py' -exec \
    sed -i 's/from crosscodex\.v1/from crosscodex_ingestion.proto.crosscodex.v1/g' {} +

# Copy application source and install the package (hatchling reads README.md and src/)
COPY --chown=1001:0 README.md .
COPY --chown=1001:0 src/ src/
COPY --chown=1001:0 scripts/check_lock_parity.py scripts/
RUN uv pip install --no-cache --no-deps .

# Fail the build if what is installed differs from the lock. pip is base-image tooling, not part
# of the lock; the project itself is installed above.
RUN uv pip freeze --exclude pip --exclude crosscodex-ingestion > /tmp/freeze.txt && \
    python scripts/check_lock_parity.py /tmp/requirements.txt /tmp/freeze.txt

# Bake in the Docling and RapidOCR models, pinned by revision (see the script): the sandboxed
# worker runs offline (HF_HUB_OFFLINE=1)
COPY --chown=1001:0 scripts/download_models.py scripts/
RUN python scripts/download_models.py /opt/app-root/docling-models

# Stage 2: Runtime - Minimal FIPS-compliant production image
FROM registry.access.redhat.com/ubi9-minimal:9.8

# Enable FIPS mode
ENV FIPS_MODE=true

WORKDIR /app

# Install Python 3.12 runtime (no pip needed at runtime) and the shared libraries OpenCV
# (imported by Docling's RapidOCR) needs at import time
RUN microdnf install -y python3.12 mesa-libGL glib2 libxcb && \
    microdnf clean all

# Create non-root user (UBI convention: uid 1001, gid 0)
RUN useradd -u 1001 -g 0 -m appuser && \
    mkdir -p /data/documents && \
    chown -R 1001:0 /app /data && \
    chmod -R g=u /app /data

# Copy installed packages from builder
# Note: UBI Python site-packages path differs from standard python:3.12-slim. In the builder,
# /opt/app-root/lib64 is a symlink to lib, so lib holds everything; copying both paths
# duplicated every package (~6 GB).
COPY --from=builder --chown=1001:0 /opt/app-root/lib/python3.12/site-packages /opt/app-root/lib/python3.12/site-packages
# Models stay root-owned and read-only to the service user: every conversion loads
# them, so a compromised process must not be able to tamper with them.
COPY --from=builder /opt/app-root/docling-models /opt/app-root/docling-models
RUN chown -R 0:0 /opt/app-root/docling-models && chmod -R a+rX,go-w /opt/app-root/docling-models

ENV DOCLING_ARTIFACTS_PATH=/opt/app-root/docling-models

# The runtime python3.12 is the system interpreter, so point it at the copied packages
ENV PYTHONPATH=/opt/app-root/lib/python3.12/site-packages

# Switch to non-root user
USER 1001

# Expose gRPC and metrics ports
EXPOSE 8080 9090

# Health check: TCP connect to the gRPC port. A gRPC channel check would need a client
# certificate under GRPC_TLS_MODE=mutual; the TLS handshake is not completed here.
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
  CMD python3.12 -c "import os, socket; socket.create_connection(('localhost', int(os.environ.get('GRPC_PORT', '8080'))), timeout=5).close()" || exit 1

# Run the service
ENTRYPOINT ["python3.12", "-m", "crosscodex_ingestion"]
