{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crosscodex-ingestion:mapping:v1",
  "title": "CrossCodex Ingestion structured-source mapping",
  "description": "Declares how one publisher release of a structured source (JSON, CSV, XLSX) becomes elements. A JSON source is a tree and uses 'nodes'; a CSV or XLSX source is a table and uses 'rows'.",
  "type": "object",
  "required": ["mapping_version", "id", "title", "source"],
  "additionalProperties": false,
  "properties": {
    "mapping_version": { "description": "Version of this mapping format.", "const": 1 },
    "id": {
      "description": "Registered name of the mapping; include the publisher's release (owasp-asvs-5.0.0-json). Lowercase letters and digits, separated by single '.' or '-'.",
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*(?![\\s\\S])"
    },
    "title": { "description": "Human-readable name of the source.", "$ref": "#/$defs/text" },
    "source": {
      "type": "object",
      "required": ["format", "release"],
      "properties": {
        "format": { "enum": ["json", "csv", "xlsx"] },
        "release": {
          "description": "Where the publisher releases the file this mapping was written for.",
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https://\\S+(?![\\s\\S])"
        }
      }
    },
    "nodes": {
      "description": "Tree sources: where the nodes are and which fields carry what.",
      "type": "object",
      "required": ["select", "id"],
      "anyOf": [{ "required": ["title"] }, { "required": ["text"] }],
      "additionalProperties": false,
      "properties": {
        "select": {
          "description": "Dotted object keys from the root to the array of top-level nodes; \"\" when the root is that array. No wildcards, filters or patterns.",
          "type": "string",
          "maxLength": 1024,
          "pattern": "^([^.]+(\\.[^.]+)*)?(?![\\s\\S])"
        },
        "children": { "description": "Key of a node's array of child nodes, at every depth.", "$ref": "#/$defs/field" },
        "id": { "$ref": "#/$defs/field" },
        "title": { "$ref": "#/$defs/field" },
        "text": { "$ref": "#/$defs/field" },
        "properties": { "$ref": "#/$defs/properties" }
      }
    },
    "rows": {
      "description": "Table sources: which columns carry what, and how a row finds its parent.",
      "type": "object",
      "anyOf": [
        { "required": ["id"], "anyOf": [{ "required": ["title"] }, { "required": ["text"] }, { "required": ["levels"] }] },
        { "required": ["level_cells"] }
      ],
      "not": {
        "anyOf": [
          { "required": ["levels", "parent"] },
          { "required": ["level_cells", "id"] },
          { "required": ["level_cells", "title"] },
          { "required": ["level_cells", "text"] },
          { "required": ["level_cells", "levels"] },
          { "required": ["level_cells", "parent"] }
        ]
      },
      "additionalProperties": false,
      "properties": {
        "levels": {
          "description": "Denormalized tables: one column pair per hierarchy level, outermost first, filled on every row. Each distinct level ID becomes one heading, nested in the order listed; the row itself nests under the last level. Cannot be combined with 'parent'.",
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "required": ["id", "title"],
            "additionalProperties": false,
            "properties": {
              "id": { "description": "Column holding the level node's ID.", "$ref": "#/$defs/field" },
              "title": { "description": "Column holding the level node's title.", "$ref": "#/$defs/field" }
            }
          }
        },
        "level_cells": {
          "description": "Tables with one column per hierarchy level, exactly one filled on each row, the ID inside the cell. A cell is 'LABEL<separator>TEXT'; the label is the ID, or, if it ends with the closing bracket, the ID is what sits between the last opening bracket and it and the rest of the label is the title. A row nests under the nearest preceding row of the previous level. Cannot be combined with id, title, text, levels or parent.",
          "type": "object",
          "required": ["columns", "separator"],
          "additionalProperties": false,
          "properties": {
            "columns": {
              "description": "The level columns, outermost first.",
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/field" }
            },
            "separator": {
              "description": "Fixed text between the label and the text; the cell is cut at its first occurrence.",
              "type": "string",
              "minLength": 1,
              "maxLength": 8
            },
            "id_brackets": {
              "description": "Fixed opening and closing text around the ID inside the label.",
              "type": "object",
              "required": ["open", "close"],
              "additionalProperties": false,
              "properties": {
                "open": { "type": "string", "minLength": 1, "maxLength": 8 },
                "close": { "type": "string", "minLength": 1, "maxLength": 8 }
              }
            }
          }
        },
        "id": { "$ref": "#/$defs/field" },
        "title": { "$ref": "#/$defs/field" },
        "text": { "$ref": "#/$defs/field" },
        "parent": {
          "oneOf": [
            {
              "description": "The parent's ID is in this column; a blank cell makes the row top-level.",
              "type": "object",
              "required": ["column"],
              "additionalProperties": false,
              "properties": { "column": { "$ref": "#/$defs/field" } }
            },
            {
              "description": "The parent's ID is the row's ID cut at the last separator (AC-2(1) -> AC-2); an ID without the separator is top-level.",
              "type": "object",
              "required": ["id_prefix"],
              "additionalProperties": false,
              "properties": {
                "id_prefix": {
                  "type": "object",
                  "required": ["separator"],
                  "additionalProperties": false,
                  "properties": { "separator": { "type": "string", "minLength": 1, "maxLength": 8 } }
                }
              }
            }
          ]
        },
        "properties": { "$ref": "#/$defs/properties" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "source": { "properties": { "format": { "const": "json" } } } } },
      "then": {
        "required": ["nodes"],
        "not": { "required": ["rows"] },
        "properties": {
          "source": { "properties": { "format": true, "release": true }, "additionalProperties": false }
        }
      }
    },
    {
      "if": { "properties": { "source": { "properties": { "format": { "const": "csv" } } } } },
      "then": {
        "required": ["rows"],
        "not": { "required": ["nodes"] },
        "properties": {
          "source": {
            "properties": {
              "format": true,
              "release": true,
              "delimiter": {
                "description": "Field delimiter; default ','. Not the quote character or a line break.",
                "type": "string",
                "minLength": 1,
                "maxLength": 1,
                "not": { "enum": ["\"", "\r", "\n"] }
              },
              "encoding": { "description": "Only UTF-8 is supported (a BOM is allowed).", "const": "utf-8" }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "source": { "properties": { "format": { "const": "xlsx" } } } } },
      "then": {
        "required": ["rows"],
        "not": { "required": ["nodes"] },
        "properties": {
          "source": {
            "required": ["sheet"],
            "properties": {
              "format": true,
              "release": true,
              "sheet": { "description": "Name of the worksheet to read.", "$ref": "#/$defs/text" },
              "header_row": { "description": "1-based row holding the column names; default 1.", "type": "integer", "minimum": 1, "maximum": 1000 }
            },
            "additionalProperties": false
          }
        }
      }
    }
  ],
  "$defs": {
    "text": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\S" },
    "field": { "description": "A JSON key or a column header, matched exactly.", "$ref": "#/$defs/text" },
    "properties": {
      "description": "Extra element properties: output name -> source field.",
      "type": "object",
      "maxProperties": 64,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,63}(?![\\s\\S])" },
      "additionalProperties": { "$ref": "#/$defs/field" }
    }
  }
}
